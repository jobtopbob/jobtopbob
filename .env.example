# =============================================================================
# JobTopBob — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ---------------------------------------------------------------------------
# Docker Compose Profiles
# ---------------------------------------------------------------------------
# Controls which services `docker compose up` starts. Set once, then use
# plain `docker compose up -d` / `docker compose down` for everything.
#
#   (unset)           → infrastructure only (Postgres, Redis, etc.) for local dev
#   prod              → infrastructure + app services (web, api, worker)
#   prod,scrapers     → everything including job discovery scrapers
#
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobtopbob
# Application role (DML only — RLS-enforced, cannot ALTER/DROP tables)
# Created by init script; migrations + Better Auth use the postgres superuser directly
POSTGRES_APP_USER=jobtopbob_app
POSTGRES_APP_PASSWORD=changeme
# Runtime connection string — uses the restricted app role (DML only, RLS-enforced)
# Uses Docker service name "postgres" — for host-based dev, override in .env.local with localhost
DATABASE_URL=postgres://jobtopbob_app:changeme@postgres:5432/jobtopbob?sslmode=disable
# Migration connection string — uses the superuser for DDL (CREATE/ALTER/DROP)
MIGRATION_DATABASE_URL=postgres://postgres:changeme@postgres:5432/jobtopbob?sslmode=disable

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=changeme
# Full connection string used by the API and worker (Pub/Sub for SSE delivery)
REDIS_URL=redis://:changeme@redis:6379/0

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Shared secret between web (Better Auth) and API (JWT verification)
BETTER_AUTH_SECRET=generate-a-random-64-char-string-here
# Public URL of the Next.js app (used by Better Auth for callbacks)
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Port the Go API listens on (default: 8080)
PORT=8080
# 32-byte hex-encoded key for encrypting OAuth tokens at rest
API_ENCRYPTION_KEY=generate-a-32-byte-hex-key
# JWKS endpoint for verifying JWTs issued by Better Auth
JWKS_URL=http://web:3000/api/auth/jwks

# ---------------------------------------------------------------------------
# AI (set the one matching your chosen provider)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_HOST=http://ollama:11434

# ---------------------------------------------------------------------------
# Email / SMTP (optional)
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ---------------------------------------------------------------------------
# File Storage (S3-compatible — RustFS in dev, any S3 provider in prod)
# ---------------------------------------------------------------------------
S3_BUCKET=jobtopbob
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_ENDPOINT=http://rustfs:9000       # RustFS/MinIO endpoint (omit for AWS S3)

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
SCRAPERS_ENABLED=true
# Set to true to seed demo user + sample data on API startup
SEED_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Resume Builder (RxResume)
# Features degrade gracefully — set only what you need:
#   - Sync:       RXRESUME_DATABASE_URL (read resume data from RxResume DB)
#   - PDF export: RESUME_PRINTER_HTTP_URL + RESUME_BUILDER_PRINTER_URL
#   - API writes: RXRESUME_API_KEY (create/delete resumes via RxResume OpenAPI)
# ---------------------------------------------------------------------------
# Internal URL for the API to communicate with the resume builder
RESUME_BUILDER_URL=http://resume-builder:3000
# Public URL users see in their browser (served by the config endpoint to the frontend)
RESUME_BUILDER_PUBLIC_URL=http://localhost:3010
# Chromium endpoint used by RxResume for PDF generation (WebSocket — used by RxResume internally)
RESUME_PRINTER_ENDPOINT=ws://resume-printer:3000
# HTTP endpoint for Browserless Chromium — used by Go API for direct PDF generation (no API key needed)
# In dev: exposed via Docker Compose on port 3020. In prod: internal Docker URL.
RESUME_PRINTER_HTTP_URL=http://resume-printer:3000
# URL the Chromium printer uses to reach the resume builder (Docker-internal, not host-facing)
# This must be reachable from inside the printer container — always use the Docker service name.
RESUME_BUILDER_PRINTER_URL=http://resume-builder:3000
# Separate auth secret for RxResume (generate with: openssl rand -hex 32)
RXRESUME_AUTH_SECRET=generate-a-random-64-char-string-here
# Read-only DB connection to RxResume (enables per-user sync)
# Uses the rxresume_reader role (SELECT only on user + resume tables)
RXRESUME_DATABASE_URL=postgres://rxresume_reader:changeme@postgres:5432/rxresume?sslmode=disable
# Optional API key for write operations (create/delete via RxResume OpenAPI)
# PDF export works without this — uses Browserless Chromium directly via RESUME_PRINTER_HTTP_URL
RXRESUME_API_KEY=
# Public URL exposed to the Next.js frontend for "Edit in Builder" links
NEXT_PUBLIC_RESUME_BUILDER_URL=http://localhost:3010
# Proxied URL for RxResume (same-origin iframe support, used as APP_URL in RxResume)
RESUME_BUILDER_PROXY_URL=http://localhost:3000/builder
# SSO: JobTopBob ↔ RxResume
# These must match between Docker Compose (root .env) and the Next.js server.
# In dev, Next.js reads apps/web/.env.local — not the root .env — so if you
# override these, set the same values in both places.
RXRESUME_OAUTH_CLIENT_ID=rxresume
RXRESUME_OAUTH_CLIENT_SECRET=rxresume-secret
# Browser-facing URL for OAuth authorization redirect (user's browser navigates here)
OAUTH_BROWSER_URL=http://localhost:3000
# Internal URL for RxResume backend to reach JobTopBob's token/userinfo endpoints
OAUTH_INTERNAL_URL=http://host.docker.internal:3000

# ---------------------------------------------------------------------------
# Scrapers (HTTP — POST /scrape returns RawJob[])
# ---------------------------------------------------------------------------
SCRAPER_LINKEDIN_URL=http://scraper-linkedin:3000
SCRAPER_INDEED_URL=http://scraper-indeed:3000
SCRAPER_GLASSDOOR_URL=http://scraper-glassdoor:3000
SCRAPER_ADZUNA_URL=http://scraper-adzuna:3000
# Adzuna API credentials (required if using the Adzuna scraper)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Hyperbrowser (optional — cloud browser for bot-hostile boards)
# When set, LinkedIn and Glassdoor scrapers use Hyperbrowser cloud sessions
# instead of local Playwright. Provides managed stealth, proxies, and CAPTCHA solving.
# Get your API key at https://hyperbrowser.ai
# HYPERBROWSER_API_KEY=

# ---------------------------------------------------------------------------
# Exposed Ports (optional — override defaults for docker compose)
# ---------------------------------------------------------------------------
# WEB_PORT=3000
# API_PORT=8080
# RESUME_BUILDER_PORT=3010
# RESUME_PRINTER_HTTP_PORT=3020
