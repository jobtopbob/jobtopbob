# =============================================================================
# .env.local — Host-based dev overrides (not loaded in Docker)
# =============================================================================
# Copy to .env.local and fill in values that differ from the Docker .env.
# The Go API loads this automatically when run via `go run ./apps/api/cmd/api`.
# Values here do NOT override existing shell env vars.
#
# You only need to add variables that aren't covered by config.go defaults.
# Most defaults (DATABASE_URL, REDIS_URL, JWKS_URL, etc.) already point to
# localhost, so you typically only need secrets and API keys here.

# RxResume API key (optional — enables create/delete via RxResume OpenAPI)
# Generate this in the RxResume admin panel.
RXRESUME_API_KEY=
